@prefix adro: <https://w3id.org/adro/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/adro/cases-national> a owl:Ontology ;
    owl:imports <https://w3id.org/adro/cases-cas> , <https://w3id.org/adro/analytes> ;
    dcterms:title "Anti-Doping Regulation Ontology: decisions of national bodies, as examples"@en ;
    rdfs:comment "Generated by scripts/build_cases_national.py. These decisions are examples selected to exercise structures the appeal register does not exercise. They are not a corpus and support no claim about frequency or distribution. Selection and per-field sourcing are stated in reports/national-examples-report.md."@en .

########  Bodies  ########

adro:UKAD a adro:NationalAntiDopingOrganization ;
    rdfs:label "UK Anti-Doping"@en .

adro:NADP a adro:Organization ;
    rdfs:label "National Anti-Doping Panel (United Kingdom)"@en ;
    rdfs:comment "The tribunal that hears at first instance the charges UK Anti-Doping brings."@en .

adro:NADPAppealTribunal a adro:Organization ;
    rdfs:label "National Anti-Doping Panel Appeal Tribunal (United Kingdom)"@en .

adro:AFLD a adro:NationalAntiDopingOrganization ;
    rdfs:label "Agence française de lutte contre le dopage"@en .

adro:USADA a adro:NationalAntiDopingOrganization ;
    rdfs:label "United States Anti-Doping Agency"@en .

adro:AAA_NACAS a adro:Organization ;
    rdfs:label "North American Court of Arbitration for Sport Panel of the American Arbitration Association"@en ;
    rdfs:comment "The panel that hears at first instance the charges the United States Anti-Doping Agency brings."@en .

########  Instruments and their provisions  ########

adro:ISTUE a adro:InternationalStandard ;
    rdfs:label "International Standard for Therapeutic Use Exemptions"@en ;
    rdfs:comment "Incorporated into the UK Anti-Doping Rules by Article 4.1, which states that the standard is binding on all Athletes and other Persons in the same way as the Rules are binding on them."@en .

adro:UKADRules_2021 a adro:NationalAntiDopingRule ;
    rdfs:label "UK Anti-Doping Rules, 1 January 2021"@en .

adro:CodeDuSport a adro:NationalLegislation ;
    rdfs:label "Code du sport (France)"@en ;
    rdfs:comment "The French state legislates on doping. A decision of the Agence française de lutte contre le dopage cites the statute, not the Code."@en .

adro:UCIADR a adro:SportGoverningBodyRule ;
    rdfs:label "UCI Anti-Doping Regulations"@en .

adro:BBBofC_ADR a adro:SportGoverningBodyRule ;
    rdfs:label "Anti-Doping Rules of the British Boxing Board of Control"@en .

adro:RFL_ADR a adro:SportGoverningBodyRule ;
    rdfs:label "Anti-Doping Rules of the Rugby Football League"@en .

adro:RFL_ADR adro:adoptsInstrument adro:UKADRules_2021 .
adro:RFL_ADR rdfs:comment "As stated in National Anti-Doping Panel (United Kingdom) SR/056/2022: The Rugby Football League has delegated the conduct of its anti-doping programme to UK Anti-Doping Limited and has adopted the UK Anti-Doping Rules."@en .

adro:BBBofC_ADR adro:adoptsInstrument adro:UKADRules_2021 .
adro:BBBofC_ADR rdfs:comment "As stated in National Anti-Doping Panel (United Kingdom) SR/007/2023: proceedings brought under the anti-doping rules of the British Boxing Board of Control to determine an Anti-Doping Rule Violation under Article 8.1 of the UK Anti-Doping Rules dated 1 January 2021."@en .

adro:UKAD_ADR_4_1 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 4.1"@en ;
    dcterms:title "Incorporation of the International Standard for Therapeutic Use Exemptions"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 ;
    rdfs:comment "The provision states that the standard sets out the circumstances in which Athletes may be granted permission to Use, for therapeutic purposes, substances or methods on the Prohibited List the Use of which would otherwise be prohibited."@en .

adro:UKAD_ADR_4_2_1 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 4.2.1"@en ;
    dcterms:title "Scope and effect of therapeutic use exemptions"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 ;
    rdfs:comment "The provision states that the presence, Use or Attempted Use, Possession or Administration of a Prohibited Substance or Prohibited Method shall not be considered an Anti-Doping Rule Violation if it is consistent with the provisions of a TUE validly granted. This is why an exemption belongs in the ontology: it defeats the prohibition stated in the same instrument."@en .

adro:UKAD_ADR_4_4 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 4.4"@en ;
    dcterms:title "Grant of a therapeutic use exemption"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 ;
    rdfs:comment "The provision states that a decision to grant must specify the dosage, frequency, route and duration of Administration permitted, and that a decision to deny must include the reasons for the denial. No correspondence to a Code article is asserted, because the instrument does not state which article it restates."@en .

adro:UKAD_ADR_2_1 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 2.1"@en ;
    dcterms:title "Presence of a Prohibited Substance or its Metabolites or Markers in an Athlete's Sample"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 ;
    adro:implementsCodeArticle adro:Article_2021_Presence .

adro:UKAD_ADR_2_2 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 2.2"@en ;
    dcterms:title "Use or Attempted Use by an Athlete of a Prohibited Substance or a Prohibited Method"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 ;
    adro:implementsCodeArticle adro:Article_2021_Use .

adro:UKAD_ADR_10_2_3 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 10.2.3"@en ;
    dcterms:title "Meaning of the term intentional as used in Article 10.2"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 .

adro:UKAD_ADR_10_4 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 10.4"@en ;
    dcterms:title "Aggravating Circumstances which may increase the period of Ineligibility"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 .

adro:UKAD_ADR_10_5 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 10.5"@en ;
    dcterms:title "Elimination of the period of Ineligibility where there is No Fault or Negligence"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 .

adro:UKAD_ADR_10_6 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 10.6"@en ;
    dcterms:title "Reduction of the period of Ineligibility based on No Significant Fault or Negligence"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 .

adro:UKAD_ADR_10_2_1a a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 10.2.1(a)"@en ;
    dcterms:title "Period of Ineligibility where the violation does not involve a Specified Substance and is intentional"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 .

adro:CodeDuSport_L232_9 a adro:InstrumentProvision ;
    rdfs:label "Code du sport, article L. 232-9"@en ;
    dcterms:title "Présence d'une ou plusieurs substances ou méthodes interdites dans l'échantillon"@en ;
    obo:BFO_0000176 adro:CodeDuSport ;
    adro:implementsCodeArticle adro:Article_2021_Presence ;
    rdfs:comment "The correspondence is asserted because the decisions themselves gloss the article in the wording of Code Article 2.1."@en .

adro:UCI_ADR_15_1 a adro:InstrumentProvision ;
    rdfs:label "UCI Anti-Doping Regulations, Article 15.1"@en ;
    dcterms:title "Anti-doping rule violation established by the presence of a prohibited substance"@en ;
    obo:BFO_0000176 adro:UCIADR ;
    rdfs:comment "No correspondence to a Code article is asserted. The decision applying this provision predates the 2021 Code, and the Code articles in this ontology are parts of the 2021 edition. A correspondence holds only between an instrument and the Code edition it restates."@en .

adro:UCI_ADR_261 a adro:InstrumentProvision ;
    rdfs:label "UCI Anti-Doping Regulations, Article 261"@en ;
    dcterms:title "Period of ineligibility for a first violation"@en ;
    obo:BFO_0000176 adro:UCIADR .

########  Jurisdictions  ########

adro:Jurisdiction_UK a adro:Jurisdiction ;
    rdfs:label "United Kingdom"@en ;
    obo:IAO_0000119 "UK Anti-Doping Rules 2021, Article 1.2" ;
    rdfs:comment "As stated in UK Anti-Doping Rules 2021, Article 1.2: These Rules apply to all Athletes and Athlete Support Personnel who are members of the NGB and/or of the NGB's members or affiliate organisations or licensees, or otherwise under the jurisdiction of the NGB."@en .

adro:Jurisdiction_France a adro:Jurisdiction ;
    rdfs:label "France"@en ;
    obo:IAO_0000119 "Code du sport, article L. 230-3" ;
    rdfs:comment "As stated in Code du sport, article L. 230-3: For the purposes of the title on the fight against doping, an athlete is any person who takes part in or prepares for a sporting event organised by an approved federation or authorised by a delegated federation, a sporting event at which prizes are awarded, or an international sporting event or one within the competence of an anti-doping organisation that is a signatory of the World Anti-Doping Code."@en .

adro:Jurisdiction_International a adro:Jurisdiction ;
    rdfs:label "international sport, under the instrument of a governing body"@en ;
    obo:IAO_0000119 "American Arbitration Association case 30 190 00847 06, paragraphs 4 and 5" ;
    rdfs:comment "As stated in American Arbitration Association case 30 190 00847 06, paragraphs 4 and 5: An international federation is responsible for the organisation of its sport worldwide, and an athlete is bound by its regulations through the licence the athlete holds; the decision says this of the UCI. The edition of the UCI regulations the decision applied was not held, so the scope is taken from the decision and not from a provision of the instrument."@en .

adro:UKADRules_2021 adro:bindsWithin adro:Jurisdiction_UK .
adro:BBBofC_ADR adro:bindsWithin adro:Jurisdiction_UK .
adro:RFL_ADR adro:bindsWithin adro:Jurisdiction_UK .
adro:CodeDuSport adro:bindsWithin adro:Jurisdiction_France .
adro:UCIADR adro:bindsWithin adro:Jurisdiction_International .

########  Grounds that lengthen or shorten a sanction  ########

adro:Ground_NoFault a adro:SanctionModifyingGround ;
    rdfs:label "No Fault or Negligence"@en ;
    adro:definedIn adro:UKAD_ADR_10_5 ;
    rdfs:comment "As stated in the instrument: The Athlete or other Person establishing that they did not know or suspect, and could not reasonably have known or suspected, even with the exercise of utmost caution, that they had Used or been administered the Prohibited Substance or Prohibited Method or otherwise violated an anti-doping rule."@en .

adro:Ground_NoSignificantFault a adro:SanctionModifyingGround ;
    rdfs:label "No Significant Fault or Negligence"@en ;
    adro:definedIn adro:UKAD_ADR_10_6 ;
    rdfs:comment "As stated in the instrument: The Athlete or other Person's establishing that any Fault or negligence, when viewed in the totality of the circumstances and taking into account the criteria for No Fault or Negligence, was not significant in relation to the Anti-Doping Rule Violation."@en .

adro:Ground_Aggravating a adro:SanctionModifyingGround ;
    rdfs:label "Aggravating Circumstances"@en ;
    adro:definedIn adro:UKAD_ADR_10_4 ;
    rdfs:comment "As stated in the instrument: Circumstances involving, or actions by, an Athlete or other Person which may justify the imposition of a period of Ineligibility greater than the standard sanction."@en .

adro:Ground_NotIntentional a adro:SanctionModifyingGround ;
    rdfs:label "violation not intentional"@en ;
    adro:definedIn adro:UKAD_ADR_10_2_3 ;
    rdfs:comment "As stated in the instrument: Where the Athlete or other Person establishes that the Anti-Doping Rule Violation was not intentional, the period of Ineligibility is two years rather than four."@en .

adro:Decision_NADP_SR_389_2024 adro:raisesGround adro:Ground_NotIntentional ;
    rdfs:comment "Ground raised and not established: the Appellant failed to discharge the burden of establishing on the balance of probability that his ADRVs were not intentional within the meaning of ADR Article 10.2.3."@en .

adro:Decision_NADP_SR_015_2023 adro:raisesGround adro:Ground_NoFault ;
    rdfs:comment "Ground raised and not established: Mr Kaye does not contend before the Appeal Tribunal that the sanction should be eliminated or reduced by reason of No Fault or Negligence or No Significant Fault or Negligence."@en .

adro:Decision_NADP_SR_015_2023 adro:raisesGround adro:Ground_NoSignificantFault ;
    rdfs:comment "Ground raised and not established: Mr Kaye does not contend before the Appeal Tribunal that the sanction should be eliminated or reduced by reason of No Fault or Negligence or No Significant Fault or Negligence."@en .

adro:Decision_NADP_SR_015_2023 adro:raisesGround adro:Ground_NotIntentional ;
    rdfs:comment "Ground raised and not established: he accepted before the Tribunal below, and on appeal, that he does not know and cannot prove how the Prohibited Substance entered his body."@en .

