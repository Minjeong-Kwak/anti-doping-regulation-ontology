    rdfs:label "urine"@en ;
    rdfs:comment "The 2026 Prohibited List states each of its decision limits as a urinary concentration, and the decisions in the corpus report their measured concentrations in urine."@en ;
    obo:IAO_0000119 "WADA, The 2026 Prohibited List (International Standard)" .

# Units in which thresholds and measured values are stated.

adro:Unit_MicrogramPerMillilitre a adro:MeasurementUnit ;
    rdfs:label "microgram per millilitre"@en ;
    rdfs:comment "Written in the 2026 Prohibited List as micrograms per millilitre and abbreviated elsewhere as ug/mL."@en ;
    obo:IAO_0000119 "WADA, The 2026 Prohibited List (International Standard)" .

adro:Unit_NanogramPerMillilitre a adro:MeasurementUnit ;
    rdfs:label "nanogram per millilitre"@en ;
    rdfs:comment "Written in the 2026 Prohibited List as nanograms per millilitre and in the decisions as ng/mL."@en ;
    obo:IAO_0000119 "WADA, The 2026 Prohibited List (International Standard)" .

# Case statuses.

adro:CaseStatus_Pending a adro:CaseStatus ;
    rdfs:label "pending"@en ;
    rdfs:comment "No final decision has been issued."@en .

adro:CaseStatus_Final a adro:CaseStatus ;
    rdfs:label "final"@en ;
    rdfs:comment "The decision is final and no appeal is outstanding."@en .

adro:CaseStatus_UnderAppeal a adro:CaseStatus ;
    rdfs:label "under appeal"@en ;
    rdfs:comment "An appeal against the decision is outstanding."@en .

adro:CaseStatus_Overturned a adro:CaseStatus ;
    rdfs:label "overturned"@en ;
    rdfs:comment "The decision was set aside on appeal."@en .

