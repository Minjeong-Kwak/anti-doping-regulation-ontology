########################################
# L2 regulatory designations
########################################

# Anti-doping rule violation types. Each is defined in a Code article.
# The ontologicalCharacter annotation records that the provisions are not
# homogeneous: some proscribe a process, some a state, some an omission.

adro:ADRVType_Presence a adro:ADRVType ;
    rdfs:label "ADRV type: Presence of a Prohibited Substance or its Metabolites or Markers in an Athlete's Sample"@en ;
    adro:definedIn adro:Article_2021_Presence ;
    adro:ontologicalCharacter "state" .

adro:ADRVType_Use a adro:ADRVType ;
    rdfs:label "ADRV type: Use or Attempted Use by an Athlete of a Prohibited Substance or a Prohibited Method"@en ;
    adro:definedIn adro:Article_2021_Use ;
    adro:ontologicalCharacter "process" .

adro:ADRVType_EvadingRefusingFailing a adro:ADRVType ;
    rdfs:label "ADRV type: Evading, refusing or failing to submit to Sample collection"@en ;
    adro:definedIn adro:Article_2021_EvadingRefusingFailing ;
    adro:ontologicalCharacter "omission" .

adro:ADRVType_WhereaboutsFailures a adro:ADRVType ;
    rdfs:label "ADRV type: Whereabouts failures"@en ;
    adro:definedIn adro:Article_2021_WhereaboutsFailures ;
    adro:ontologicalCharacter "omission" .

adro:ADRVType_Tampering a adro:ADRVType ;
    rdfs:label "ADRV type: Tampering or Attempted Tampering with any part of Doping Control"@en ;
    adro:definedIn adro:Article_2021_Tampering ;
    adro:ontologicalCharacter "process" .

adro:ADRVType_Possession a adro:ADRVType ;
    rdfs:label "ADRV type: Possession of a Prohibited Substance or a Prohibited Method"@en ;
    adro:definedIn adro:Article_2021_Possession ;
    adro:ontologicalCharacter "state" .

adro:ADRVType_Trafficking a adro:ADRVType ;
    rdfs:label "ADRV type: Trafficking or Attempted Trafficking in any Prohibited Substance or Prohibited Method"@en ;
    adro:definedIn adro:Article_2021_Trafficking ;
    adro:ontologicalCharacter "process" .

adro:ADRVType_Administration a adro:ADRVType ;
    rdfs:label "ADRV type: Administration or Attempted Administration to any Athlete of any Prohibited Substance or Prohibited Method"@en ;
    adro:definedIn adro:Article_2021_Administration ;
    adro:ontologicalCharacter "process" .

adro:ADRVType_Complicity a adro:ADRVType ;
    rdfs:label "ADRV type: Complicity or Attempted Complicity"@en ;
    adro:definedIn adro:Article_2021_Complicity ;
    adro:ontologicalCharacter "process" .

adro:ADRVType_ProhibitedAssociation a adro:ADRVType ;
    rdfs:label "ADRV type: Prohibited Association by an Athlete or other Person"@en ;
    adro:definedIn adro:Article_2021_ProhibitedAssociation ;
    adro:ontologicalCharacter "state" .

adro:ADRVType_Retaliation a adro:ADRVType ;
    rdfs:label "ADRV type: Acts by an Athlete or other Person to discourage or retaliate against reporting to authorities"@en ;
    adro:definedIn adro:Article_2021_Retaliation ;
    adro:ontologicalCharacter "process" .

# Prohibited substance and method categories.

adro:Category_S0 a adro:ProhibitedSubstanceCategory ;
    rdfs:label "S0 Non-approved substances"@en ;
    adro:definedIn adro:Entry_2026_S0 .

adro:Category_S1 a adro:ProhibitedSubstanceCategory ;
    rdfs:label "S1 Anabolic agents"@en ;
    adro:definedIn adro:Entry_2026_S1 .

