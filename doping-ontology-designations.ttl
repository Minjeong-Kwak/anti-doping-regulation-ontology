@prefix adro: <https://w3id.org/adro/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/adro/designations> a owl:Ontology ;
    owl:imports <https://w3id.org/adro/> ;
    dcterms:title "Anti-Doping Regulation Ontology: normative documents and regulatory designations"@en ;
    rdfs:comment "Generated by scripts/build_designations.py from the 2026 Prohibited List and Article 2 of the 2021 World Anti-Doping Code."@en .

########################################
# L1 normative documents
########################################

adro:WADACode_2021 a adro:WorldAntiDopingCode ;
    rdfs:label "World Anti-Doping Code 2021"@en ;
    adro:hasEffectiveFrom "2021-01-01T00:00:00"^^xsd:dateTime .

adro:ProhibitedList_2026 a adro:ProhibitedListEdition ;
    rdfs:label "The 2026 Prohibited List"@en ;
    adro:hasEffectiveFrom "2026-01-01T00:00:00"^^xsd:dateTime ;
    adro:hasEffectiveTo   "2026-12-31T00:00:00"^^xsd:dateTime ;
    adro:issuedBy adro:WADA .

adro:WADA a adro:AntiDopingOrganization ;
    rdfs:label "World Anti-Doping Agency"@en .

adro:Article_2021_Presence a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.1"@en ;
    dcterms:title "Presence of a Prohibited Substance or its Metabolites or Markers in an Athlete's Sample"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_Use a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.2"@en ;
    dcterms:title "Use or Attempted Use by an Athlete of a Prohibited Substance or a Prohibited Method"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_EvadingRefusingFailing a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.3"@en ;
    dcterms:title "Evading, refusing or failing to submit to Sample collection"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_WhereaboutsFailures a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.4"@en ;
    dcterms:title "Whereabouts failures"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_Tampering a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.5"@en ;
    dcterms:title "Tampering or Attempted Tampering with any part of Doping Control"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_Possession a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.6"@en ;
    dcterms:title "Possession of a Prohibited Substance or a Prohibited Method"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_Trafficking a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.7"@en ;
    dcterms:title "Trafficking or Attempted Trafficking in any Prohibited Substance or Prohibited Method"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_Administration a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.8"@en ;
    dcterms:title "Administration or Attempted Administration to any Athlete of any Prohibited Substance or Prohibited Method"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_Complicity a adro:CodeArticle ;
    rdfs:label "World Anti-Doping Code 2021, Article 2.9"@en ;
    dcterms:title "Complicity or Attempted Complicity"@en ;
    obo:BFO_0000176 adro:WADACode_2021 .

adro:Article_2021_ProhibitedAssociation a adro:CodeArticle ;
