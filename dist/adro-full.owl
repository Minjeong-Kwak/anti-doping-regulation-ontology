  <rdf:Description rdf:about="https://w3id.org/adro/Decision_NADP_SR_056_2022">
    <rdf:type rdf:resource="https://w3id.org/adro/FirstInstanceDecision"/>
    <rdf:type rdf:resource="https://w3id.org/adro/SanctionDecision"/>
    <rdfs:label xml:lang="en">SR/056/2022</rdfs:label>
    <dcterms:title xml:lang="en">UK Anti-Doping v Rowland Kaye</dcterms:title>
    <adro:issuedBy rdf:resource="https://w3id.org/adro/NADP"/>
    <adro:hasCaseIdentifier>SR/056/2022</adro:hasCaseIdentifier>
    <adro:hasDecisionDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-01-04T00:00:00</adro:hasDecisionDate>
    <adro:appliedProvision rdf:resource="https://w3id.org/adro/UKAD_ADR_2_1"/>
    <adro:assignsType rdf:resource="https://w3id.org/adro/ADRVType_Presence"/>
    <adro:mentions rdf:resource="https://w3id.org/adro/Substance_Oxymetholone_Methasterone_LTM"/>
    <adro:hasSanctionType rdf:resource="https://w3id.org/adro/SanctionType_Ineligibility"/>
    <adro:establishes rdf:resource="https://w3id.org/adro/Ineligibility_NADP_SR_056_2022"/>
    <rdfs:comment xml:lang="en">The charge names a metabolite whose parent substance the deciding body records as indeterminate between two listed substances. The decision is the example of a violation established without identifying a single Prohibited List entry.</rdfs:comment>
    <adro:hasSourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.sportresolutions.com/disputes/anti-doping</adro:hasSourceURL>
    <adro:hasRetrievalDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-09-10T00:00:00</adro:hasRetrievalDate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/adro/SanctionModifyingGround">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">sanction modifying ground</rdfs:label>
    <rdfs:label xml:lang="ko">제재 조정 사유</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A designation of a circumstance which, if established, lengthens or shortens the period of ineligibility that would otherwise follow from an established violation.</obo:IAO_0000115>
    <rdfs:comment xml:lang="en">A designation rather than a class of circumstances, for the same reason as the violation types: whether a circumstance counts as such a ground is fixed by a provision of a stated instrument, not by the circumstance itself.</rdfs:comment>
  </rdf:Description>
