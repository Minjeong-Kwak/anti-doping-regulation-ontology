  <rdf:Description rdf:about="https://w3id.org/adro/UKAD_ADR_4_2_1">
    <rdf:type rdf:resource="https://w3id.org/adro/InstrumentProvision"/>
    <rdfs:label xml:lang="en">UK Anti-Doping Rules 2021, Article 4.2.1</rdfs:label>
    <dcterms:title xml:lang="en">Scope and effect of therapeutic use exemptions</dcterms:title>
    <obo:BFO_0000176 rdf:resource="https://w3id.org/adro/UKADRules_2021"/>
    <rdfs:comment xml:lang="en">The provision states that the presence, Use or Attempted Use, Possession or Administration of a Prohibited Substance or Prohibited Method shall not be considered an Anti-Doping Rule Violation if it is consistent with the provisions of a TUE validly granted. This is why an exemption belongs in the ontology: it defeats the prohibition stated in the same instrument.</rdfs:comment>
  </rdf:Description>
