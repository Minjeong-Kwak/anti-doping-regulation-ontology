  <rdf:Description rdf:about="https://w3id.org/adro/Metabolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/adro/ChemicalSubstance"/>
    <rdfs:label xml:lang="en">metabolite</rdfs:label>
    <rdfs:label xml:lang="ko">대사체</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A chemical substance that is produced by the metabolism of another chemical substance.</obo:IAO_0000115>
    <rdfs:comment xml:lang="en">Article 2.1 of the Code concerns the presence of a prohibited substance or its metabolites or markers in a sample, so a metabolite is distinguished from the listed substance it derives from. A metabolite is not itself an entry of the Prohibited List and therefore carries no prohibition applicability of its own.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/adro/ProhibitedList_2023">
    <rdf:type rdf:resource="https://w3id.org/adro/ProhibitedListEdition"/>
    <rdfs:label xml:lang="en">World Anti-Doping Agency 2023 Prohibited List</rdfs:label>
    <adro:issuedBy rdf:resource="https://w3id.org/adro/WADA"/>
    <obo:IAO_0000119>National Anti-Doping Panel (United Kingdom) SR/007/2023</obo:IAO_0000119>
    <rdfs:comment xml:lang="en">As stated in National Anti-Doping Panel (United Kingdom) SR/007/2023: Metandienone is listed under section 1.1 of the WADA 2023 Prohibited List as an Anabolic Androgenic Steroid. It is a non-Specified Substance that is prohibited at all times.</rdfs:comment>
    <rdfs:comment xml:lang="en">As stated on the cover of World Anti-Doping Agency, The 2023 Prohibited List: This List shall come into effect on 1 January 2023.</rdfs:comment>
    <adro:hasEffectiveFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-01-01T00:00:00</adro:hasEffectiveFrom>
  </rdf:Description>
