  <rdf:Description rdf:about="https://w3id.org/adro/Decision_NADP_SR_015_2023">
    <adro:raisesGround rdf:resource="https://w3id.org/adro/Ground_NoFault"/>
    <adro:raisesGround rdf:resource="https://w3id.org/adro/Ground_NoSignificantFault"/>
    <adro:raisesGround rdf:resource="https://w3id.org/adro/Ground_NotIntentional"/>
    <rdfs:comment xml:lang="en">Ground raised and not established: Mr Kaye does not contend before the Appeal Tribunal that the sanction should be eliminated or reduced by reason of No Fault or Negligence or No Significant Fault or Negligence.</rdfs:comment>
    <rdfs:comment xml:lang="en">Ground raised and not established: he accepted before the Tribunal below, and on appeal, that he does not know and cannot prove how the Prohibited Substance entered his body.</rdfs:comment>
    <rdfs:comment xml:lang="en">The appeal was dismissed and the period of ineligibility confirmed.</rdfs:comment>
    <rdf:type rdf:resource="https://w3id.org/adro/AppealDecision"/>
    <rdf:type rdf:resource="https://w3id.org/adro/SanctionDecision"/>
    <rdfs:label xml:lang="en">SR/015/2023</rdfs:label>
