    obo:BFO_0000057 adro:LNDD ;
    obo:IAO_0000119 "American Arbitration Association case 30 190 00847 06" ;
    rdfs:comment "As stated in American Arbitration Association case 30 190 00847 06: The charge of exogenous testosterone being found in the sample by the Carbon Isotope Ratio analysis is established in accordance with the UCI Anti-Doping Regulations."@en ;
    adro:concernsCase adro:CaseRecord_AAA_30_190_00847_06 ;
    adro:hasAnalyticalMethod "carbon isotope ratio analysis" ;
    adro:hasSpecifiedInput adro:SamplePortion_AAA_30_190_00847_06_A,
        adro:Sample_AAA_30_190_00847_06 ;
    adro:hasSpecifiedOutput adro:Finding_AAA_30_190_00847_06 .

