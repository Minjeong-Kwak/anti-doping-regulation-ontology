    rdfs:label "dental-intracanal"@en .

adro:Route_Dermal a adro:RouteOfAdministration ;
    rdfs:label "dermal"@en .

adro:Route_Inhaled a adro:RouteOfAdministration ;
    rdfs:label "inhaled"@en .

adro:Route_Intranasal a adro:RouteOfAdministration ;
    rdfs:label "intranasal"@en .

adro:Route_Intravenous a adro:RouteOfAdministration ;
    rdfs:label "intravenous"@en .

adro:Route_Ophthalmological a adro:RouteOfAdministration ;
    rdfs:label "ophthalmological"@en .

adro:Route_Otic a adro:RouteOfAdministration ;
    rdfs:label "otic"@en .

adro:Route_Perianal a adro:RouteOfAdministration ;
    rdfs:label "perianal"@en .

adro:SanctionType_FinancialConsequence a adro:SanctionType ;
    rdfs:label "financial consequence"@en ;
    obo:IAO_0000119 "Code 2021 Article 10.12" .

adro:SanctionType_LifetimeIneligibility a adro:SanctionType ;
    rdfs:label "lifetime ineligibility"@en ;
    obo:IAO_0000119 "Code 2021 Article 10.3; a period of ineligibility of lifetime, carrying no numeric duration" .

adro:SanctionType_ProvisionalSuspension a adro:SanctionType ;
    rdfs:label "provisional suspension"@en ;
    obo:IAO_0000119 "Code 2021 Article 7.4 and UK Anti-Doping Rules 2021 Article 7.10" .

adro:UKAD a adro:NationalAntiDopingOrganization ;
    rdfs:label "UK Anti-Doping"@en .

adro:UKAD_ADR_4_1 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 4.1"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 ;
    dcterms:title "Incorporation of the International Standard for Therapeutic Use Exemptions"@en ;
    rdfs:comment "The provision states that the standard sets out the circumstances in which Athletes may be granted permission to Use, for therapeutic purposes, substances or methods on the Prohibited List the Use of which would otherwise be prohibited."@en .

adro:UKAD_ADR_4_2_1 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 4.2.1"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 ;
    dcterms:title "Scope and effect of therapeutic use exemptions"@en ;
    rdfs:comment "The provision states that the presence, Use or Attempted Use, Possession or Administration of a Prohibited Substance or Prohibited Method shall not be considered an Anti-Doping Rule Violation if it is consistent with the provisions of a TUE validly granted. This is why an exemption belongs in the ontology: it defeats the prohibition stated in the same instrument."@en .

adro:UKAD_ADR_4_4 a adro:InstrumentProvision ;
    rdfs:label "UK Anti-Doping Rules 2021, Article 4.4"@en ;
    obo:BFO_0000176 adro:UKADRules_2021 ;
    dcterms:title "Grant of a therapeutic use exemption"@en ;
    rdfs:comment "The provision states that a decision to grant must specify the dosage, frequency, route and duration of Administration permitted, and that a decision to deny must include the reasons for the denial. No correspondence to a Code article is asserted, because the instrument does not state which article it restates."@en .

adro:USADA a adro:NationalAntiDopingOrganization ;
    rdfs:label "United States Anti-Doping Agency"@en .

adro:acceptsGround a owl:ObjectProperty ;
    rdfs:label "accepts ground"@en ;
    obo:IAO_0000115 "Relates a decision to a ground it establishes, so that the period of ineligibility is altered accordingly."@en ;
    rdfs:domain adro:Decision ;
    rdfs:range adro:SanctionModifyingGround ;
    rdfs:subPropertyOf adro:raisesGround .

adro:adoptsInstrument a owl:ObjectProperty ;
    rdfs:label "adopts instrument"@en ;
    obo:IAO_0000115 "Relates an anti-doping instrument to another instrument that it takes over in place of stating its own rules."@en ;
    rdfs:comment "Relates the instrument of a governing body to the instrument it takes over in place of stating its own rules. Asserted only where a decision or the instrument itself states the adoption."@en ;
    rdfs:domain adro:AntiDopingInstrument ;
    rdfs:range adro:AntiDopingInstrument .

adro:appliedEdition a owl:ObjectProperty ;
    rdfs:label "applied edition"@en ;
    obo:IAO_0000115 "Relates a decision to the edition of a normative document that the deciding body applied."@en ;
    rdfs:domain adro:Decision ;
    rdfs:range obo:IAO_0000310 .

adro:appliedProvision a owl:ObjectProperty ;
    rdfs:label "applied provision"@en ;
    obo:IAO_0000115 "Relates a decision to the provision that the deciding body applied in reaching its determination."@en ;
    rdfs:comment "The provision the deciding body applied in reaching its determination, in the numbering the decision itself uses."@en ;
    rdfs:domain adro:Decision ;
    rdfs:range adro:InstrumentProvision .

adro:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    obo:IAO_0000115 "Relates a prohibition applicability to the chemical substance whose prohibition it states."@en ;
    rdfs:domain adro:ProhibitionApplicability ;
    rdfs:range adro:ChemicalSubstance .

adro:assignsType a owl:ObjectProperty ;
    rdfs:label "assigns type"@en ;
    obo:IAO_0000115 "Relates a decision to the violation type that the deciding body assigned to the matter."@en ;
    rdfs:comment "A decision assigns a violation type to a matter. Violation types are not asserted as classes of events."@en ;
    rdfs:domain adro:Decision ;
    rdfs:range adro:ADRVType .

adro:bindsWithin a owl:ObjectProperty ;
    rdfs:label "binds within"@en ;
    obo:IAO_0000115 "Relates an anti-doping instrument to the jurisdiction its own scope provision states."@en ;
    rdfs:domain adro:AntiDopingInstrument ;
    rdfs:range adro:Jurisdiction .

adro:broaderCategory a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "broader category"@en ;
    obo:IAO_0000115 "Relates a regulatory designation to a designation under which it falls."@en ;
    rdfs:comment "Transitive. Supports inference over designation hierarchies without subsumption."@en ;
    rdfs:domain obo:IAO_0000030 ;
    rdfs:range obo:IAO_0000030 .

adro:competitionContext a owl:ObjectProperty ;
    rdfs:label "competition context"@en ;
    obo:IAO_0000115 "Relates a prohibition applicability or a sample collection to the designation of the competition context in which it holds or occurs."@en ;
    rdfs:comment "Qualifies a prohibition applicability, which holds in a stated context, and a sample collection, which occurs in one. No domain is asserted because the two are of different categories."@en ;
    rdfs:range adro:CompetitionContext .

adro:concernsCase a owl:ObjectProperty ;
    rdfs:label "concerns case"@en ;
    obo:IAO_0000115 "Relates an entity to the case record that gathers the matter it belongs to."@en ;
    rdfs:comment "Gathers into one matter the entities a decision states belong to it."@en ;
    rdfs:range adro:CaseRecord .

adro:concernsJurisdiction a owl:ObjectProperty ;
    rdfs:label "concerns jurisdiction"@en ;
    obo:IAO_0000115 "Relates a case record or a prohibition applicability to the jurisdiction within which it holds."@en ;
    rdfs:range adro:Jurisdiction .

adro:concernsPerson a owl:ObjectProperty ;
    rdfs:label "concerns person"@en ;
    obo:IAO_0000115 "Relates an information content entity to the person it is about."@en ;
    rdfs:comment "Inferred for a record about a sample: such a record concerns the person that sample was collected from, and the relation is not asserted for it. Asserted only for a document addressed to a named person, such as a notice of charge."@en ;
    rdfs:domain obo:IAO_0000030 ;
    rdfs:range adro:Person ;
    owl:propertyChainAxiom ( obo:IAO_0000136 adro:collectedFrom ) .

adro:concernsSport a owl:ObjectProperty ;
    rdfs:label "concerns sport"@en ;
    obo:IAO_0000115 "Relates a case record to the designation of the sport in which the matter arose."@en ;
    rdfs:domain adro:CaseRecord ;
    rdfs:range adro:Sport .

adro:definedIn a owl:ObjectProperty ;
    rdfs:label "defined in"@en ;
    obo:IAO_0000115 "Relates a regulatory designation to the document part that specifies it."@en ;
    rdfs:comment "Links a regulatory designation to the document part that specifies it."@en ;
    rdfs:domain obo:IAO_0000030 ;
    rdfs:range obo:IAO_0000314 .

adro:establishes a owl:ObjectProperty ;
    rdfs:label "establishes"@en ;
    obo:IAO_0000115 "Relates a decision to the role it brings into being in the person it concerns."@en ;
    rdfs:comment "A sanction decision establishes an ineligibility; an exemption decision establishes an exemption. The domain is the decision, not the sanction decision, because both are determinations that bring a status into being."@en ;
    rdfs:domain adro:Decision ;
    rdfs:range obo:BFO_0000023 .

adro:full a owl:Ontology ;
    dcterms:title "Anti-Doping Regulation Ontology, complete"@en ;
    rdfs:comment "Built by scripts/build_release.py from the modules, which are the source. Do not edit this file: edit the module and build again. The Basic Formal Ontology and the Information Artifact Ontology are imported by IRI rather than merged in; the OASIS catalog in this directory resolves them, and every module, to local copies."@en ;
    owl:imports obo:bfo.owl,
        obo:iao.owl ;
    owl:versionIRI <https://w3id.org/adro/full/2026-10-07> .

adro:hasAnalysisDateTime a owl:DatatypeProperty ;
    rdfs:label "has analysis date time"@en ;
    obo:IAO_0000115 "The time at which a laboratory analysis was carried out or reported, as the source states it."@en ;
    rdfs:domain adro:LaboratoryAnalysis ;
    rdfs:range xsd:dateTime .

adro:hasAnalyticalMethod a owl:DatatypeProperty ;
    rdfs:label "has analytical method"@en ;
    obo:IAO_0000115 "The analytical method applied, in the words the source uses for it."@en ;
    rdfs:comment "The method as the decision names it. Recorded as a string because the decisions name methods in their own terms and no method vocabulary is asserted here."@en ;
    rdfs:domain adro:LaboratoryAnalysis ;
    rdfs:range xsd:string .

adro:hasCaseIdentifier a owl:DatatypeProperty ;
    rdfs:label "has case identifier"@en ;
    obo:IAO_0000115 "The reference by which the issuing institution identifies a matter or a decision."@en ;
    rdfs:domain adro:Decision ;
    rdfs:range xsd:string .

adro:hasCategory a owl:ObjectProperty ;
    rdfs:label "has category"@en ;
    obo:IAO_0000115 "Relates a prohibition applicability to the designation of the category under which the substance or method falls."@en ;
    rdfs:domain adro:ProhibitionApplicability .

adro:hasCollectionDateTime a owl:DatatypeProperty ;
    rdfs:label "has collection date time"@en ;
    obo:IAO_0000115 "The time at which a sample was collected, as the source states it."@en ;
    rdfs:domain adro:SampleCollection ;
    rdfs:range xsd:dateTime .

adro:hasDecisionDate a owl:DatatypeProperty ;
    rdfs:label "has decision date"@en ;
    obo:IAO_0000115 "The date on which a decision was issued, as the decision states it."@en ;
    rdfs:domain adro:Decision ;
    rdfs:range xsd:dateTime .

adro:hasDecisionLimit a owl:ObjectProperty ;
    rdfs:label "has decision limit"@en ;
    obo:IAO_0000115 "Relates a prohibition applicability to the decision limit above which a finding is reported."@en ;
    rdfs:domain adro:ProhibitionApplicability ;
    rdfs:range adro:DecisionLimit .

adro:hasEffectiveFrom a owl:DatatypeProperty ;
    rdfs:label "has effective from"@en ;
    obo:IAO_0000115 "The time from which a document, an edition or a status takes effect."@en ;
    rdfs:range xsd:dateTime .

adro:hasEffectiveTo a owl:DatatypeProperty ;
    rdfs:label "has effective to"@en ;
    obo:IAO_0000115 "The time at which a document, an edition or a status ceases to have effect."@en ;
    rdfs:range xsd:dateTime .

adro:hasEndDateTime a owl:DatatypeProperty ;
    rdfs:label "has end date time"@en ;
    obo:IAO_0000115 "The time at which a process ended, where the source states an interval."@en ;
    rdfs:comment "Asserted only where a process ran over a stated interval. A process the decision places on a single day carries a start alone."@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range xsd:dateTime .

adro:hasExternalIdentifier a owl:DatatypeProperty ;
    rdfs:label "has external identifier"@en ;
    obo:IAO_0000115 "An identifier by which an entity is known in a resource outside this ontology, written as a prefixed identifier such as CHEBI:15365."@en ;
    rdfs:comment "No value is asserted in this release. The mapping is mechanical and the source is public: scripts/map_external_identifiers.py reads the ChEBI flat files, or the ChEBI service, and asserts an identifier only where a substance name equals a ChEBI name or synonym exactly. Run it where that source can be reached, and load the file it writes alongside this one."@en ;
    rdfs:domain obo:BFO_0000040 ;
    rdfs:range xsd:string .

adro:hasIneligibilityDurationInMonths a owl:DatatypeProperty ;
    rdfs:label "has ineligibility duration in months"@en ;
    obo:IAO_0000115 "The length of a period of ineligibility, in months, as a number."@en ;
    rdfs:comment "Months, as a number. xsd:duration lies outside the OWL 2 datatype map and cannot be used in a range axiom without breaking reasoning, so the unit is fixed by the property instead. Lifetime ineligibility carries no duration and is expressed by a sanction type designation."@en ;
    rdfs:domain adro:IneligibilityStatus ;
    rdfs:range xsd:decimal .

adro:hasIssueDateTime a owl:DatatypeProperty ;
    rdfs:label "has issue date time"@en ;
    obo:IAO_0000115 "The time at which a document was issued by the body that issued it."@en ;
    rdfs:domain obo:IAO_0000310 ;
    rdfs:range xsd:dateTime .

adro:hasMeasuredValue a owl:DatatypeProperty ;
    rdfs:label "has measured value"@en ;
    obo:IAO_0000115 "The numeric value a measurement reports."@en ;
    rdfs:domain adro:Measurement ;
    rdfs:range xsd:decimal .

adro:hasMeasurementUnit a owl:ObjectProperty ;
    rdfs:label "has measurement unit"@en ;
    obo:IAO_0000115 "Relates a measurement or a decision limit to the designation of the unit in which its value is expressed."@en ;
    rdfs:comment "The domain is the union of the two. Asserting the domain as measurement alone, as an earlier version did, made every decision limit a measurement by inference, which is wrong: a threshold the List states is not a value an analysis reported."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( adro:Measurement adro:DecisionLimit ) ] ;
    rdfs:range adro:MeasurementUnit .

adro:hasPortion a owl:ObjectProperty ;
    rdfs:label "has portion"@en ;
    obo:IAO_0000115 "Relates a sample to a portion of it that carries its own reference."@en ;
    rdfs:domain adro:Sample ;
    rdfs:range adro:SamplePortion ;
    rdfs:subPropertyOf obo:BFO_0000178 .

adro:hasRetrievalDate a owl:DatatypeProperty ;
    rdfs:label "has retrieval date"@en ;
    obo:IAO_0000115 "The date on which the document was obtained from the address recorded for it."@en ;
    rdfs:comment "A decision may be corrected or replaced after it is published. The retrieval date states which state of the document the assertions here were taken from."@en ;
    rdfs:domain obo:IAO_0000310 ;
    rdfs:range xsd:dateTime .

adro:hasSampleIdentifier a owl:DatatypeProperty ;
    rdfs:label "has sample identifier"@en ;
    obo:IAO_0000115 "The reference the collecting authority assigns to a sample or to a portion of one."@en ;
    rdfs:comment "The reference the collecting authority assigns to a sample or to a portion of one, and the decision reproduces."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( adro:Sample adro:SamplePortion ) ] ;
    rdfs:range xsd:string .

adro:hasSourceURL a owl:DatatypeProperty ;
    rdfs:label "has source URL"@en ;
    obo:IAO_0000115 "The address at which the issuing body published the document."@en ;
    rdfs:comment "Recorded in addition to the issuing body and the identifier, not in place of them. An address can change; the body and its own reference are what let a reader retrieve the document when it does."@en ;
    rdfs:domain obo:IAO_0000310 ;
    rdfs:range xsd:anyURI .

adro:hasSpecimenMatrix a owl:ObjectProperty ;
    rdfs:label "has specimen matrix"@en ;
    obo:IAO_0000115 "Relates a measurement or a decision limit to the designation of the kind of specimen in which it is stated."@en ;
    rdfs:comment "The domain is the union of the two, because a threshold and the measurement it is compared with are each stated in a matrix, and neither is a kind of the other."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( adro:Measurement adro:DecisionLimit ) ] ;
    rdfs:range adro:SpecimenMatrix .

adro:hasStartDateTime a owl:DatatypeProperty ;
    rdfs:label "has start date time"@en ;
    obo:IAO_0000115 "The time at which a process began."@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range xsd:dateTime .

adro:hasThresholdValue a owl:DatatypeProperty ;
    rdfs:label "has threshold value"@en ;
    obo:IAO_0000115 "The numeric value at or above which a decision limit is exceeded."@en ;
    rdfs:domain adro:DecisionLimit ;
    rdfs:range xsd:decimal .

adro:implementsCodeArticle a owl:ObjectProperty ;
    rdfs:label "implements Code article"@en ;
    obo:IAO_0000115 "Relates a provision of an instrument other than the Code to the Code article it restates."@en ;
    rdfs:comment "Relates a provision of another instrument to the Code article it restates. The relation is asserted only where the instrument itself states the correspondence or the deciding body relies on it."@en ;
    rdfs:domain adro:InstrumentProvision ;
    rdfs:range adro:CodeArticle .

adro:initiatedBy a owl:ObjectProperty ;
    rdfs:label "initiated by"@en ;
    obo:IAO_0000115 "Relates a process to the document by which it was set in motion."@en ;
    rdfs:comment "The document by which a process was set in motion, where a decision states one. A charge letter opens a determination; a notice of appeal opens an appeal."@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:IAO_0000310 .

adro:isEvidenceFor a owl:ObjectProperty ;
    rdfs:label "is evidence for"@en ;
    obo:IAO_0000115 "Relates an analytical finding to the determination process it bears upon."@en ;
    rdfs:domain adro:AdverseAnalyticalFinding ;
    rdfs:range adro:ADRVDeterminationProcess .

adro:isMetaboliteOf a owl:ObjectProperty ;
    rdfs:label "is metabolite of"@en ;
    obo:IAO_0000115 "Relates a metabolite to a substance from which a biotransformation process produces it."@en ;
    rdfs:domain adro:Metabolite ;
    rdfs:range adro:ChemicalSubstance .

adro:isSpecified a owl:DatatypeProperty ;
    rdfs:label "is specified"@en ;
    obo:IAO_0000115 "Whether a Prohibited List entry is designated as specified, which governs the range of sanction available."@en ;
    rdfs:comment "Whether the substances or methods covered by this Prohibited List entry are Specified within the meaning of Code Article 4.2.2. Recorded on the entry rather than on the category, because the designation is edition-dependent."@en ;
    rdfs:domain adro:ProhibitedListEntry ;
    rdfs:range xsd:boolean .

adro:isSpecifiedOutputOf a owl:ObjectProperty ;
    rdfs:label "is specified output of"@en ;
    obo:IAO_0000115 "Relates an entity to the process that produced it."@en ;
    owl:inverseOf adro:hasSpecifiedOutput .

adro:issuedBy a owl:ObjectProperty ;
    rdfs:label "issued by"@en ;
    obo:IAO_0000115 "Relates a document to the organization that issued it."@en ;
    rdfs:range adro:Organization .

adro:mentions a owl:ObjectProperty ;
    rdfs:label "mentions"@en ;
    obo:IAO_0000115 "Relates an information content entity to a substance it names."@en ;
    rdfs:comment "Relates a decision to a substance it names. A mention records what the document states. It does not assert that the substance was present in a sample, nor that a violation was established in respect of it."@en ;
    rdfs:domain obo:IAO_0000030 ;
    rdfs:range adro:ChemicalSubstance .

adro:ontologicalCharacter a owl:AnnotationProperty ;
    rdfs:label "ontological character"@en ;
    rdfs:comment "Records whether the conduct or circumstance proscribed by a rule provision is a process, a state, or an omission. The provisions of Code Article 2 are not homogeneous in this respect."@en .

adro:resultsManagementAuthority a owl:ObjectProperty ;
    rdfs:label "results management authority"@en ;
    obo:IAO_0000115 "Relates a case record to the organization that managed the results of the matter."@en ;
    rdfs:domain adro:CaseRecord ;
    rdfs:range adro:AntiDopingOrganization .

adro:routeOfAdministration a owl:ObjectProperty ;
    rdfs:label "route of administration"@en ;
    obo:IAO_0000115 "Relates a prohibition applicability to the designation of the route of administration to which it is confined."@en ;
    rdfs:domain adro:ProhibitionApplicability ;
    rdfs:range adro:RouteOfAdministration .

adro:sportScope a owl:ObjectProperty ;
    rdfs:label "sport scope"@en ;
    obo:IAO_0000115 "Relates a prohibition applicability to the designation of a sport to which it is confined."@en ;
    rdfs:domain adro:ProhibitionApplicability ;
    rdfs:range adro:Sport .

adro:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en ;
    obo:IAO_0000115 "The time from which a prohibition applicability holds."@en ;
    rdfs:domain adro:ProhibitionApplicability ;
    rdfs:range xsd:dateTime .

adro:validTo a owl:DatatypeProperty ;
    rdfs:label "valid to"@en ;
    obo:IAO_0000115 "The time at which a prohibition applicability ceases to hold."@en ;
    rdfs:domain adro:ProhibitionApplicability ;
    rdfs:range xsd:dateTime .

