adro:ExemptionStatus a owl:Class ;
    rdfs:label "exemption status"@en,
        "면책 지위"@ko ;
    obo:IAO_0000115 "A role borne by a person during the interval in which that person is permitted to use a stated prohibited substance or method for a therapeutic purpose."@en ;
    rdfs:comment "Modelled as a role for the same reason as ineligibility status: it exists by virtue of an institutional circumstance and does not alter the physical make-up of its bearer. It is distinguished from the decision that grants it, which is a document."@en ;
    rdfs:subClassOf obo:BFO_0000023 .

adro:Jurisdiction_International a adro:Jurisdiction ;
    rdfs:label "international sport, under the instrument of a governing body"@en ;
    obo:IAO_0000119 "American Arbitration Association case 30 190 00847 06, paragraphs 4 and 5" ;
    rdfs:comment "As stated in American Arbitration Association case 30 190 00847 06, paragraphs 4 and 5: An international federation is responsible for the organisation of its sport worldwide, and an athlete is bound by its regulations through the licence the athlete holds; the decision says this of the UCI. The edition of the UCI regulations the decision applied was not held, so the scope is taken from the decision and not from a provision of the instrument."@en .

adro:Laboratory a owl:Class ;
    rdfs:label "laboratory"@en,
        "실험실"@ko ;
    obo:IAO_0000115 "An organization accredited to analyse samples collected in doping control."@en ;
