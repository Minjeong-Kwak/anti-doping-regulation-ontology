    obo:IAO_0000119 "National Anti-Doping Panel (United Kingdom) SR/007/2023" ;
    rdfs:comment "As stated in National Anti-Doping Panel (United Kingdom) SR/007/2023: On 9 June 2023, UKAD Doping Control Personnel collected a urine Sample from the Athlete following a heavyweight bout at York Hall, London."@en ;
    adro:competitionContext adro:CompetitionContext_InCompetition ;
    adro:concernsCase adro:CaseRecord_NADP_SR_007_2023 ;
    adro:hasCollectedSample adro:Sample_NADP_SR_007_2023 ;
    adro:hasCollectionDateTime "2023-06-09T00:00:00"^^xsd:dateTime .

adro:SampleCollection_NADP_SR_056_2022 a adro:SampleCollection ;
    rdfs:label "sample collection in National Anti-Doping Panel (United Kingdom) SR/056/2022"@en ;
    obo:BFO_0000057 adro:Person_Rowland_Kaye ;
    obo:IAO_0000119 "National Anti-Doping Panel (United Kingdom) SR/056/2022" ;
    rdfs:comment "As stated in National Anti-Doping Panel (United Kingdom) SR/056/2022: On 5 January 2022 a UKAD Doping Control Officer attended the Hunslet RLFC ground in order to carry out testing. Mr Kaye was selected to take a urine test. He completed the Doping Control Form and provided a urine Sample."@en ;
    adro:concernsCase adro:CaseRecord_NADP_SR_056_2022 ;
    adro:hasCollectedSample adro:Sample_NADP_SR_056_2022 ;
    adro:hasCollectionDateTime "2022-01-05T00:00:00"^^xsd:dateTime .

