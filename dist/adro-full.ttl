            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty adro:bearerOfRole ;
                    owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf ( adro:ExemptionStatus [ a owl:Restriction ;
                                        owl:hasValue adro:Substance_Metandienone ;
                                        owl:onProperty adro:exemptionFor ] ) ] ] ],
        adro:Person ;
    rdfs:label "Emir Ahmatovic"@en ;
    obo:IAO_0000119 "National Anti-Doping Panel (United Kingdom) SR/007/2023" ;
    rdfs:comment "As stated in National Anti-Doping Panel (United Kingdom) SR/007/2023: The Athlete did not have a Therapeutic Use Exemption for metandienone. The statement is recorded as the absence of an exemption for that substance, and not as the absence of any exemption."@en ;
    adro:bearerOfRole adro:AthleteRole_Emir_Ahmatovic,
        adro:Ineligibility_NADP_SR_007_2023,
        adro:ProvisionalSuspension_NADP_SR_007_2023 ;
    adro:concernsCase adro:CaseRecord_NADP_SR_007_2023 .

