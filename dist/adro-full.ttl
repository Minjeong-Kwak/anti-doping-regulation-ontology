adro:ADRVDeterminationProcess a owl:Class ;
    rdfs:label "ADRV determination process"@en,
        "위반 판정 절차"@ko ;
    obo:IAO_0000115 "A results management process in which it is determined whether a given matter constitutes an anti-doping rule violation."@en ;
    rdfs:comment "This process exists irrespective of whether the rule provision at issue concerns a process, a state, or an omission. Whether a violation is established is asserted by a decision record, not by the type of this process."@en ;
    rdfs:subClassOf adro:ResultsManagementProcess .

adro:AthleteRole a owl:Class ;
    rdfs:label "athlete role"@en,
        "선수 역할"@ko ;
    obo:IAO_0000115 "A role borne by a person during the interval in which that person is subject to anti-doping regulation in connection with sporting competition."@en ;
    rdfs:comment "The role ceases when the person is no longer subject to regulation, while the person persists. This is why athlete is not a subtype of person."@en ;
    rdfs:subClassOf obo:BFO_0000023 .

