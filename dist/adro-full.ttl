adro:Decision_AAA_30_190_00170_07 a adro:FirstInstanceDecision,
        adro:SanctionDecision ;
    rdfs:label "AAA No. 30 190 00170 07"@en ;
    dcterms:title "United States Anti-Doping Agency v. Justin Gatlin"@en ;
    rdfs:comment "The award as published states no date of issue, so none is asserted."@en,
        "The period of ineligibility runs from a date thirty days after the sample was taken, and the panel treated an earlier finding as a first violation."@en ;
    adro:assignsType adro:ADRVType_Presence ;
    adro:establishes adro:Ineligibility_AAA_30_190_00170_07 ;
    adro:hasCaseIdentifier "AAA No. 30 190 00170 07" ;
    adro:hasRetrievalDate "2026-09-10T00:00:00"^^xsd:dateTime ;
    adro:hasSanctionType adro:SanctionType_Disqualification,
        adro:SanctionType_Ineligibility ;
    adro:hasSourceURL "https://www.usada.org/results/arbitration-decisions/"^^xsd:anyURI ;
    adro:issuedBy adro:AAA_NACAS ;
    adro:mentions adro:Substance_Testosterone .

adro:Decision_AAA_30_190_00847_06 a adro:FirstInstanceDecision,
        adro:SanctionDecision ;
    rdfs:label "AAA Case No. 30 190 00847 06"@en ;
    dcterms:title "United States Anti-Doping Agency v. Floyd Landis"@en ;
    rdfs:comment "The panel dismissed the charge founded on the ratio of testosterone to epitestosterone and upheld the charge founded on carbon isotope ratio analysis. The decision is the example of a determination in which one analytical charge fails and another succeeds on the same sample."@en ;
    adro:appliedProvision adro:UCI_ADR_15_1,
        adro:UCI_ADR_261 ;
    adro:assignsType adro:ADRVType_Presence ;
    adro:establishes adro:Ineligibility_AAA_30_190_00847_06 ;
    adro:hasCaseIdentifier "AAA Case No. 30 190 00847 06" ;
    adro:hasDecisionDate "2007-09-20T00:00:00"^^xsd:dateTime ;
    adro:hasRetrievalDate "2026-09-10T00:00:00"^^xsd:dateTime ;
    adro:hasSanctionType adro:SanctionType_Disqualification,
        adro:SanctionType_Ineligibility ;
    adro:hasSourceURL "https://www.usada.org/results/arbitration-decisions/"^^xsd:anyURI ;
    adro:issuedBy adro:AAA_NACAS ;
    adro:mentions adro:Substance_Testosterone .

adro:Decision_NADP_SR_007_2023 a adro:FirstInstanceDecision,
        adro:SanctionDecision ;
    rdfs:label "SR/007/2023"@en ;
    dcterms:title "UK Anti-Doping v Emir Ahmatovic"@en ;
    rdfs:comment "Two violations determined on one sample: presence of the metabolite, and use of the parent substance. The decision is the example of a single sample supporting more than one violation type."@en ;
    adro:appliedEdition adro:ProhibitedList_2023 ;
    adro:appliedProvision adro:UKAD_ADR_2_1,
        adro:UKAD_ADR_2_2 ;
    adro:assignsType adro:ADRVType_Presence,
        adro:ADRVType_Use ;
    adro:establishes adro:Ineligibility_NADP_SR_007_2023 ;
