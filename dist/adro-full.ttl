adro:SanctionModifyingGround a owl:Class ;
    rdfs:label "sanction modifying ground"@en,
        "제재 조정 사유"@ko ;
    obo:IAO_0000115 "A designation of a circumstance which, if established, lengthens or shortens the period of ineligibility that would otherwise follow from an established violation."@en ;
    rdfs:comment "A designation rather than a class of circumstances, for the same reason as the violation types: whether a circumstance counts as such a ground is fixed by a provision of a stated instrument, not by the circumstance itself."@en ;
    rdfs:subClassOf obo:IAO_0000030 .

