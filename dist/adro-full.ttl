adro:Decision_NADP_SR_015_2023 a adro:AppealDecision,
        adro:SanctionDecision ;
    rdfs:label "SR/015/2023"@en ;
    dcterms:title "Rowland Kaye v UK Anti-Doping"@en ;
    rdfs:comment "Ground raised and not established: Mr Kaye does not contend before the Appeal Tribunal that the sanction should be eliminated or reduced by reason of No Fault or Negligence or No Significant Fault or Negligence."@en,
        "Ground raised and not established: he accepted before the Tribunal below, and on appeal, that he does not know and cannot prove how the Prohibited Substance entered his body."@en,
        "The appeal was dismissed and the period of ineligibility confirmed."@en ;
    adro:appealsAgainst adro:Decision_NADP_SR_056_2022 ;
    adro:appliedProvision adro:UKAD_ADR_2_1 ;
    adro:assignsType adro:ADRVType_Presence ;
