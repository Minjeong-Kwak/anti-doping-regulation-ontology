    rdfs:comment "Incorporated into the UK Anti-Doping Rules by Article 4.1, which states that the standard is binding on all Athletes and other Persons in the same way as the Rules are binding on them."@en .

adro:LaboratoryAnalysis_AAA_30_190_00170_07 a adro:LaboratoryAnalysis ;
    rdfs:label "analysis of the A sample in American Arbitration Association case 30 190 00170 07"@en ;
    obo:BFO_0000057 adro:UCLA_Laboratory ;
    obo:IAO_0000119 "American Arbitration Association case 30 190 00170 07" ;
    rdfs:comment "As stated in American Arbitration Association case 30 190 00170 07: the UCLA Laboratory, through accepted scientific procedures and without error, accurately determined by carbon isotope ratio analysis the sample positive for the finding of the substance testosterone or its precursors."@en ;
    adro:concernsCase adro:CaseRecord_AAA_30_190_00170_07 ;
    adro:hasAnalyticalMethod "carbon isotope ratio analysis" ;
    adro:hasSpecifiedInput adro:SamplePortion_AAA_30_190_00170_07_A,
        adro:Sample_AAA_30_190_00170_07 ;
    adro:hasSpecifiedOutput adro:Finding_AAA_30_190_00170_07 .

