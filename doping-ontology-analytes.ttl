@prefix adro: <https://w3id.org/adro/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/adro/analytes> a owl:Ontology ;
    owl:imports <https://w3id.org/adro/substances> ;
    dcterms:title "Anti-Doping Regulation Ontology: metabolites named in the case corpus"@en ;
    rdfs:comment "Generated by scripts/build_analytes.py. Each metabolite relation is asserted only where a decision in the corpus states it, and that decision is cited. Where a decision records that the parent substance cannot be determined, the relation is asserted to every parent the decision names."@en .

adro:Substance_Benzoylecgonine a adro:Metabolite ;
    rdfs:label "Benzoylecgonine"@en ;
    adro:isMetaboliteOf adro:Substance_Cocaine ;
    obo:IAO_0000119 "CAS 2006/A/1130" ;
    rdfs:comment "As stated in CAS 2006/A/1130: Benzoylecgonine and Methylecgonine, which are metabolites of cocaine."@en .

adro:Substance_Methylecgonine a adro:Metabolite ;
    rdfs:label "Methylecgonine"@en ;
    adro:isMetaboliteOf adro:Substance_Cocaine ;
    obo:IAO_0000119 "CAS 2006/A/1130" ;
    rdfs:comment "As stated in CAS 2006/A/1130: Benzoylecgonine and Methylecgonine, which are metabolites of cocaine."@en .

adro:Substance_CarboxyTHC a adro:Metabolite ;
    rdfs:label "Carboxy-THC"@en ;
    adro:isMetaboliteOf adro:Substance_Tetrahydrocannabinols ;
    obo:IAO_0000119 "CAS 2008/A/1577" ;
    rdfs:comment "As stated in CAS 2008/A/1577: Carboxy-THC (THCA), a metabolite of marijuana."@en .

adro:Substance_Norandrosterone_19 a adro:Metabolite ;
    rdfs:label "19-Norandrosterone"@en ;
    rdfs:label "Norandrosterone"@en ;
    adro:isMetaboliteOf adro:Substance_Nandrolone ;
    obo:IAO_0000119 "CAS 2010/A/2311" ;
    rdfs:comment "As stated in CAS 2010/A/2311: Norandrosterone is a metabolite of nandrolone or its precursors."@en .

adro:Substance_Noretiocholanolone_19 a adro:Metabolite ;
    rdfs:label "19-Noretiocholanolone"@en ;
    adro:isMetaboliteOf adro:Substance_Nandrolone ;
    obo:IAO_0000119 "CAS 2017/A/5175" ;
    rdfs:comment "As stated in CAS 2017/A/5175: 19-norandrosterone and 19-noretiocholanolone, which are metabolites of nandrolone."@en .

adro:Substance_Metandienone_LTM a adro:Metabolite ;
    rdfs:label "17β-hydroxymethyl,17α-methyl-18-norandrost-1,4,13-trien-3-one"@en ;
    adro:isMetaboliteOf adro:Substance_Metandienone ;
    obo:IAO_0000119 "National Anti-Doping Panel (United Kingdom) SR/007/2023" ;
    rdfs:comment "As stated in National Anti-Doping Panel (United Kingdom) SR/007/2023: a Metabolite of the Prohibited Substance metandienone, namely 17β-hydroxymethyl,17α-methyl-18-norandrost-1,4,13-trien-3-one."@en .

adro:Substance_Oxymetholone_Methasterone_LTM a adro:Metabolite ;
    rdfs:label "18-nor-17β-hydroxymethyl-17α-methyl-2α-methyl-5α-androst-13-en-3-one"@en ;
    adro:isMetaboliteOf adro:Substance_Oxymetholone , adro:Substance_Methasterone ;
    rdfs:comment "The deciding body recorded that the parent substance cannot be determined between those named. Both are asserted; neither is asserted to the exclusion of the other."@en ;
    obo:IAO_0000119 "National Anti-Doping Panel (United Kingdom) SR/056/2022" ;
    rdfs:comment "As stated in National Anti-Doping Panel (United Kingdom) SR/056/2022: either oxymetholone or methasterone could be a parent substance of the Metabolite; it is not scientifically possible to specify which of the two was in fact the relevant parent."@en .

adro:Substance_Oxandrolone_LTM a adro:Metabolite ;
    rdfs:label "17a-hydroxymethyl-17β-methyl-18-nor-2-oxa-5a-androst-13-en-3-one"@en ;
    adro:isMetaboliteOf adro:Substance_Oxandrolone ;
    obo:IAO_0000119 "Agence française de lutte contre le dopage D. 2025-01" ;
    rdfs:comment "As stated in Agence française de lutte contre le dopage D. 2025-01: 17a-hydroxymethyl-17β-methyl-18-nor-2-oxa-5a-androst-13-en-3-one, métabolite long terme de l'oxandrolone."@en .

